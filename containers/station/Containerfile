# Station image: what every factory station needs to run inside a container
# (#418). The tools the station scripts call, plus the Claude Code CLI. Built
# by scripts/build-station-image.sh, which pins the base image and the CLI.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# jq, PyYAML and shellcheck are what scripts/*.sh call; curl and
# ca-certificates are for the CLI and git over HTTPS.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git jq python3 python3-yaml shellcheck \
  && rm -rf /var/lib/apt/lists/*

# gh from the official release, pinned and digest-verified. Debian's package
# (2.46.0) has no `gh pr checks --json`, which scripts/pr-status.sh needs, so
# the ready gate could not read checks inside the container (#430).
ARG GH_VERSION
ARG GH_SHA256
RUN curl -fsSL --proto '=https' --tlsv1.2 --retry 3 --max-time 120 -o /tmp/gh.tar.gz \
    "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
  && echo "${GH_SHA256}  /tmp/gh.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/gh.tar.gz -C /tmp \
  && install -m 0755 "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
  && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_amd64" \
  && gh --version

ARG CLAUDE_CODE_VERSION
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
  && npm cache clean --force

# No credentials, no user config: the runner mounts a tmpfs HOME and forwards
# the provider credential and a GitHub token by name at start.
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_AUTOUPDATER=1
